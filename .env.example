# Required for the contact form
BREVO_API_KEY=
ADMIN_EMAIL=
SENDER_EMAIL=
NEXT_PUBLIC_SITE_URL=https://camponez.com.br

# Optional: shared rate limit across serverless instances (Upstash Redis).
# Without these, an in-memory per-instance limit is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: Cloudflare Turnstile captcha on the contact form.
# Without these, the form is not protected by a captcha.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
